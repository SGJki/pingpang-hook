#!/usr/bin/env node

import { spawn, spawnSync } from "node:child_process";
import { existsSync, readFileSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";

const event = process.argv[2] ?? "complete";
if (!["approval", "codex-approval", "claude-approval", "complete"].includes(event)) {
  process.stderr.write("Usage: pingpang-sound {approval|codex-approval|claude-approval|complete}\n");
  process.exit(64);
}

const defaultBlacklist = [
  String.raw`(?:^|[;&|]\s*)sudo(?:\s|$)`,
  String.raw`(?:^|[;&|]\s*)rm(?:\s|$)`,
  String.raw`(?:^|[;&|]\s*)git\s+(?:push|reset\s+--hard|clean)(?:\s|$)`,
  String.raw`(?:^|[;&|]\s*)(?:shutdown|reboot|halt|mkfs|dd)(?:\s|$)`,
  String.raw`(?:^|[;&|]\s*)chmod\s+-R(?:\s|$)`,
  String.raw`(?:^|[;&|]\s*)(?:curl|wget)\b[^\n]*\|\s*(?:sh|bash|zsh)(?:\s|$)`
];

function soundFor(eventName) {
  switch (eventName) {
    case "approval":
    case "codex-approval":
    case "claude-approval":
      return process.env.PINGPANG_APPROVAL_SOUND ?? "/System/Library/Sounds/Glass.aiff";
    case "complete":
      return process.env.PINGPANG_COMPLETE_SOUND ?? "/System/Library/Sounds/Hero.aiff";
    default:
      throw new Error("Usage: pingpang-sound {approval|codex-approval|claude-approval|complete}");
  }
}

function commandExists(command) {
  return !spawnSync(command, ["--help"], { stdio: "ignore" }).error;
}

function readInput() {
  try {
    const value = readFileSync(0, "utf8").trim();
    return value ? JSON.parse(value) : null;
  } catch {
    return null;
  }
}

function blacklistPath() {
  return join(homedir(), ".pingpang-hook", "blacklist");
}

// Both platforms run this same script, so the file below is a single shared
// config; it is staged for Claude Code first. To enable it for Codex as well,
// drop the mode check in blacklistPatterns().
function filePatterns() {
  try {
    return readFileSync(blacklistPath(), "utf8")
      .split(/\r?\n/)
      .map((line) => line.trim())
      .filter((line) => line.length > 0 && !line.startsWith("#"));
  } catch {
    return [];
  }
}

function blacklistPatterns(event) {
  const custom = process.env.PINGPANG_APPROVAL_BLACKLIST ?? "";
  return [
    ...defaultBlacklist,
    ...(event === "claude-approval" ? filePatterns() : []),
    ...custom
      .split(/\r?\n|,/)
      .map((pattern) => pattern.trim())
      .filter(Boolean)
  ];
}

function isBlacklisted(command, event) {
  try {
    return blacklistPatterns(event).some((pattern) => new RegExp(pattern, "i").test(command));
  } catch {
    // A malformed policy must never turn into an automatic approval.
    return true;
  }
}

function shouldAutoApprove(input, event) {
  if (input?.hook_event_name !== "PermissionRequest") return false;
  // Claude Code plan mode is an explicit review state; never auto-approve there.
  // Codex payloads carry no permission_mode field, so this cannot affect Codex.
  if (input.permission_mode === "plan") return false;
  const command = input.tool_input?.command;
  return typeof command === "string" && command.length > 0 && !isBlacklisted(command, event);
}

function playSound(sound) {
  const player = process.platform === "darwin" ? "afplay" : "paplay";
  if (existsSync(sound) && commandExists(player)) {
    const child = spawn(player, [sound], { detached: true, stdio: "ignore" });
    child.unref();
    return;
  }

  // Retain a usable, dependency-free fallback on terminals without a sound daemon.
  process.stderr.write("\u0007");
}

// Codex and Claude Code accept the same PermissionRequest decision JSON, so both
// approval modes share this branch; the codex-approval path is unchanged.
if (event === "codex-approval" || event === "claude-approval") {
  const input = readInput();
  if (shouldAutoApprove(input, event)) {
    process.stdout.write(JSON.stringify({
      hookSpecificOutput: {
        hookEventName: "PermissionRequest",
        decision: { behavior: "allow" }
      }
    }));
  } else {
    playSound(soundFor(event));
  }
} else {
  playSound(soundFor(event));
}
